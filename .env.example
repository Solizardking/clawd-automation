# ── Clawd Automaton ──────────────────────────────────────────
# Local shell runtime — no Conway control plane.
CLAWD_SANDBOX_ID=local
# Optional local survival-tier balance (cents). Default 10000 ($100).
# CLAWD_CREDITS_CENTS=10000

# ── Inference (OpenRouter only) ──────────────────────────────
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free Models Router — random free model that supports your request features
# (tool calling, vision, etc.). Docs: free-router guide on openrouter.ai
OPENROUTER_FREE_MODEL=openrouter/free

# Optional: pin a paid / specific model instead of free (leave unset to prefer free)
# OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional provider routing: price | throughput | latency
# OPENROUTER_PROVIDER_SORT=throughput

# Attribution (OpenRouter rankings)
OPENROUTER_SITE_URL=https://x402.wtf
OPENROUTER_APP_NAME=Clawd Automaton

# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# auto | openrouter  (legacy conway/clawd values map to openrouter)
INFERENCE_PROVIDER=auto

# ── Solana trench (optional trading / portfolio rails) ───────
# Helius RPC + API for on-chain reads and DAS
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
# HELIUS_API_KEY=
# Jupiter quote/swap
# JUPITER_API_KEY=
# DFlow trading / prediction markets
# DFLOW_API_KEY=

# ── ZK primitives (zk-primitives/ — observer by default) ─────
# Required only for on-chain attestations / compressed state writes
# CLAWD_ZK_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
# CLAWD_ZK_PROGRAM_ID=CLAWDzk11111111111111111111111111111111111
# CLAWD_ZK_PHOTON_URL=
# CLAWD_ZK_KEYPAIR=
# CLAWD_ZK_NETWORK=mainnet-beta
# Override tree path (default: ./zk-primitives)
# CLAWDBOT_ZK_PRIMITIVES_DIR=

