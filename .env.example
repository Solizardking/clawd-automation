# ── Conway Automaton ──────────────────────────────────────────
CONWAY_API_URL=https://api.conway.tech
# CONWAY_API_KEY=

# ── Inference backend ─────────────────────────────────────────
# auto (default): use OpenRouter when OPENROUTER_API_KEY is set, else Conway
# openrouter | conway
INFERENCE_PROVIDER=auto

# ── OpenRouter (https://openrouter.ai/docs/llms.txt) ──────────
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free Models Router — random free model that supports your request features
# (tool calling, vision, etc.). Docs: free-router guide on openrouter.ai
OPENROUTER_FREE_MODEL=openrouter/free

# Optional: pin a paid / specific model instead of free (leave unset to prefer free)
# OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional provider routing: price | throughput | latency
# OPENROUTER_PROVIDER_SORT=throughput

# Attribution (OpenRouter rankings)
OPENROUTER_SITE_URL=https://conway.tech
OPENROUTER_APP_NAME=Conway Automaton

# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
