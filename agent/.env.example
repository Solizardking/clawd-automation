# ─────────────────────────────────────────────────────────────────────────────
# OpenClawd Solana Kit — environment template
#
# Quick start:
#   1. Copy this file:   cp agent/.env.example agent/.env
#   2. Fill in the values marked "required"
#   3. Run:              make -C agent setup
#
# The crate auto-loads `.env` at startup (dotenv), so Rust code and examples
# pick these up automatically. NEVER commit `.env` — the repo .gitignore
# already excludes it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Anthropic API key used by rig-core to build every agent (Solana/EVM/HTTP).
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Solana RPC endpoint.
# The public mainnet endpoint is used as a fallback, but a private endpoint
# (Helius, QuickNode, Triton, etc.) is strongly recommended for reliable
# trading / portfolio work.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Local Solana signer (local agents & examples) ────────────────────────────

# Base58-encoded private key for LocalSolanaSigner.
# Generate a fresh one with:
#   solana-keygen new --no-bip39-passphrase --outfile agent/keypair.json
# then set SOLANA_PRIVATE_KEY to the printed base58 value.
#
# ⚠️  Dev only. NEVER commit this value or the keypair.json file.
SOLANA_PRIVATE_KEY=

# ── Optional Solana behaviour ────────────────────────────────────────────────

# Set to 1 to skip transaction simulation before sending (faster, less safe).
# SKIP_SIMULATION=1

# Path to a keypair JSON file used by pump.fun integration tests.
# FUND_KEYPAIR_PATH=./keypair.json

# ── EVM (features: evm / cross-chain / full) ─────────────────────────────────

# EVM-compatible RPC endpoint (e.g. Arbitrum, Base, Ethereum mainnet).
# ETHEREUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Hex private key (0x-prefixed) for the local EVM signer.
# ETHEREUM_PRIVATE_KEY=0x...

# ── HTTP service + Privy delegated signing (feature: http / full) ────────────

# Used by the `kit` binary / HTTP service. Do NOT set local private keys here.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Phoenix / Rise perps (paper-first) ───────────────────────────────────────

# Perps integrations default to paper mode — live orders require explicit
# approval, a passing preflight, and a concrete payload.
# PERPS_MODE=paper
# PERPS_MARKET=SOL-PERP
# PHOENIX_PERPS_URL=
# RISE_PERPS_URL=

# ── Clawd constitution overrides (optional) ──────────────────────────────────

# The kit auto-discovers the monorepo `constitution/` bundle next to the crate.
# Override only if you need a custom path.
# CLAWD_CONSTITUTION_PATH=/abs/path/to/constitution.md
# CLAWD_RULES_PATH=/abs/path/to/clawd-rules.txt
# CLAWD_KIT_ROOT=/abs/path/to/agent

# ── Logging ──────────────────────────────────────────────────────────────────

# Optional. Controls verbosity: error | warn | info | debug | trace
# RUST_LOG=info